# Copy to .env and fill in. .env is git-ignored.
MISTRAL_API_KEY=            # console.mistral.ai, free tier
OPENAGENDA_API_KEY=         # openagenda.com, account settings
RAG_API_KEY=                # any secret string; required by POST /rebuild (X-API-Key header)

# Optional: Langfuse tracing of every question (cloud.langfuse.com, free tier).
# Leave empty to disable; nothing else changes.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
